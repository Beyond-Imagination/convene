# 운영 EC2 의 환경 파일 템플릿. EC2 의 docker-compose.prod.yml 옆에 .env 로 복사해 채운다.
# 실제 .env 는 git 에 커밋하지 않는다(시크릿 포함, .gitignore 처리됨).
#
#   cp .env.prod.template .env  &&  vi .env

# 이미지 태그(운영=latest). GHCR: ghcr.io/beyond-imagination/convene-{backend,ai-worker}
IMAGE_TAG=latest

# ===== Caddy / TLS =====
# 이 EC2 백엔드의 FQDN. DNS A 레코드가 이 EC2 public IP 를 가리켜야 인증서가 발급된다.
# (임시로 개인 도메인 서브도메인 사용 가능 — 추후 교체 시 이 값만 바꾸면 Caddy 가 재발급)
DOMAIN=convene-api.example.com
# Let's Encrypt 알림 메일(선택, 비워도 됨)
ACME_EMAIL=

# ===== backend =====
# 프론트(CloudFront/도메인) origin. 콤마로 여러 개 가능. mixed-content 때문에 https 여야 함.
CORS_ORIGIN=https://convene.example.com
# 이 EC2 의 public IP — mediasoup 가 클라이언트에 알릴 주소(미디어 경로).
ANNOUNCED_IP=
# mediasoup RTC 포트 범위. 보안그룹에 동일 범위를 UDP+TCP 로 오픈해야 한다.
RTC_MIN_PORT=40000
RTC_MAX_PORT=40199
MEDIASOUP_WORKER_NUM=1
# STT 모델 크기(small 유지 권장 — medium 은 한국어 품질이 더 나쁨)
STT_MODEL_SIZE=small

# ===== 회의록 기능(필수) =====
# 비우면 NoopSummarizer 로 대체(요약 없이 회의록만 생성).
GEMINI_API_KEY=
# 요약 모델(미설정 시 gemini-2.5-flash). 무료 한도/비용에 따라 gemini-2.0-flash 등으로 교체.
GEMINI_MODEL=
# MongoDB Atlas connection string(끝에 dbname 박지 말 것).
MONGO_URI=
MONGO_DB_NAME=convene-prod
