# Convene 백엔드 리버스 프록시 — TLS 종단 전용.
#
# {$DOMAIN} = 백엔드 FQDN(.env 의 DOMAIN). Caddy 가 Let's Encrypt 인증서를 자동
# 발급/갱신한다. 전제: 80·443 이 외부에 열려 있고, DOMAIN 의 DNS A 레코드가 이 호스트
# (EC2 public IP)를 가리켜야 한다.
#
# Socket.IO(WebSocket) 업그레이드는 reverse_proxy 가 자동 처리한다. CloudFront 와 달리
# 유휴 타임아웃 제약이 없어 장기 시그널링 소켓에 적합하다.
#
# ai-worker(8000)·redis(6379)는 여기로 노출하지 않는다 — backend 만 proxy 한다.
#
# 만료 알림 메일을 받고 싶으면 전역 블록을 추가한다(값이 있을 때만 — 빈 email 은 파싱 에러):
#   { email you@example.com }

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy backend:5000
}
