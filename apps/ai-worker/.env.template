# AI Worker(FastAPI + faster-whisper) 환경 변수 템플릿.
# 모두 선택 항목으로, 미설정 시 표기된 기본값이 쓰인다.
# 이 파일을 복사해 apps/ai-worker/.env 를 만든다(또는 환경변수로 직접 주입).

# faster-whisper STT 옵션
# STT_MODEL_SIZE=small      # 모델 크기. 2GB 인스턴스에 들어가는 유일한 후보다
# STT_LANGUAGE=ko           # STT 언어
# STT_CPU_THREADS=2         # CPU 스레드 수
# STT_BEAM_SIZE=1           # beam search 크기(클수록 느리고 약간 정확)
# STT_VAD_FILTER=true       # 무음 구간 제거. 끄면 무음까지 디코딩해 느려진다
# STT_INITIAL_PROMPT=...    # 기본값 없음(비활성). 회의 주제가 매번 달라 고정 프롬프트는 두지 않는다.

# 개발 전용 — 받은 오디오를 wav 로 떨군다(벤치 샘플 수집용).
# 운영에서는 설정하지 않는다. 오디오는 전사 후 즉시 폐기가 원칙이다.
# STT_DUMP_DIR=/app/bench/samples/raw
