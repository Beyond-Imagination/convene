# Frontend(Next.js) 환경 변수 템플릿.
# 이 파일을 복사해 apps/frontend/.env.local 을 만든다:  cp .env.template .env.local
#
# NEXT_PUBLIC_* 만 클라이언트 번들에 노출되며, 정적 export(output: 'export') 에서는
# 빌드 타임에 인라인된다. 따라서 배포 빌드 시점에 운영 백엔드 URL 을 넣어야 한다.

# 백엔드 HTTP/WS base URL. 기본(미설정 시) http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
