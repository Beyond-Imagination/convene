# Backend(NestJS) 환경 변수 템플릿.
# 이 파일을 복사해 apps/backend/.env 를 만든다:  cp .env.template .env
# 주석 처리된 항목은 미설정 시 표기된 기본값이 쓰인다.
#
# 값의 성격은 셋 중 하나다.
#   [운영필수] 기본값은 로컬 개발용이며 NODE_ENV=production 이면 미설정 시 부팅에 실패한다.
#             폴백하면 조용히 잘못된 대상에 붙기 때문이다(예: MONGO_DB_NAME → dev DB).
#   [게이트]   비우면 그 기능만 꺼진 채 부팅된다. 무엇이 꺼졌는지는 backend listening 로그의
#             features 필드로 확인한다.
#   [튜닝]     기본값 그대로 써도 되는 값.

# ===== 권장(회의록 기능에 필요) =====

# [게이트] Google Gemini API 키 — LLM 회의록 요약에 사용.
# 비우면 NoopSummarizer 로 대체되어 요약 없이 회의록만 생성된다.
GEMINI_API_KEY=

# [운영필수] MongoDB 접속 문자열(Atlas connection string 또는 로컬). dbname 은 박지 말 것.
# 기본: mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
# [운영필수] 회의·회의록 database 이름. 환경별로 분리(dev/prod). 기본값 convene-dev 는 로컬 전용.
MONGO_DB_NAME=convene-dev

# [게이트] 관리자 재요약 엔드포인트(POST /reports/:id/resummarize) 인증 토큰.
# Authorization: Bearer <이 값> 으로 호출을 가른다. 비우면 엔드포인트가 비활성(403)된다.
# 임의의 랜덤 문자열을 직접 생성해 넣는다(예: openssl rand -hex 32).
ADMIN_API_TOKEN=

# ===== 선택(미설정 시 기본값) =====

# HTTP/WS 포트. 기본 5000 (frontend dev 가 3000 을 쓰므로 backend 는 5000)
# PORT=5000
# [운영필수] CORS 허용 origin(콤마 구분). 운영은 CloudFront 도메인. 기본값은 로컬 전용.
# CORS_ORIGIN=http://localhost:3000

# 로깅. 기본 레벨 info / 구조화 JSON 출력.
# LOG_LEVEL=info     # trace|debug|info|warn|error|fatal|silent. 잘못된 값이면 기동 실패.
# LOG_PRETTY=true    # 로컬 가독성용 pino-pretty(컬러) 출력. production 에선 무시되고 항상 JSON.

# New Relic APM. 키 미설정 시 agent 비활성(로컬/CI no-op).
# NEW_RELIC_LICENSE_KEY=             # 설정 시 APM·분산추적·로그 forwarding 활성

# [운영필수] Redis 접속. 기본값은 로컬 전용 / key prefix 는 튜닝값.
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=convene:

# ai-worker(STT, FastAPI) base URL. 기본 http://localhost:8000
# docker-compose 로 띄울 땐 http://ai-worker:8000
# AI_WORKER_BASE_URL=http://localhost:8000
# AI_WORKER_MAX_ATTEMPTS=3          # 5xx·네트워크 실패 시 총 시도 횟수. 1이면 재시도 없음
# AI_WORKER_RETRY_BASE_DELAY_MS=500 # 재시도 백오프 기준 간격. 시도마다 2배(상한 8초)

# Gemini 상세 옵션. 기본 모델 gemini-2.5-flash / 타임아웃 30000ms
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=30000
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_MAX_ATTEMPTS=3             # 429·5xx·네트워크 실패 시 총 시도 횟수. 1이면 재시도 없음
# GEMINI_RETRY_BASE_DELAY_MS=500    # 재시도 백오프 기준 간격. 시도마다 2배(상한 8초)

# Mediasoup / WebRTC
# ANNOUNCED_IP=127.0.0.1            # [운영필수] 클라이언트에 알릴 공인 IP. 폴백하면 미디어만 조용히 안 붙는다
# RTC_MIN_PORT=40000                # WebRTC UDP/TCP 포트 범위 시작
# RTC_MAX_PORT=49999                # WebRTC UDP/TCP 포트 범위 끝
# MEDIASOUP_WORKER_NUM=1            # worker 수. 'auto' = CPU 코어 수
# MEDIASOUP_PARTICIPANTS_PER_ROUTER=5
# MEDIASOUP_LOG_LEVEL=warn
# ENABLE_UDP=true
# ENABLE_TCP=true
# PREFER_UDP=true

# ffmpeg 바이너리 경로. PATH 에 ffmpeg 가 있으면 설정 불필요.
# FFMPEG_BIN=ffmpeg

# STT 전처리 필터 체인. 미설정 시 노이즈 게이트(agate)가 걸린다.
# 벤치 샘플을 떠낼 때만 `none` 으로 꺼서 필터 전 오디오를 확보한다
# (필터를 거친 오디오에는 후보 체인을 다시 걸어 비교할 수 없다).
# FFMPEG_AUDIO_FILTER=none

# ===== v2 노션 연동 (미설정 시 전체 dormant) =====

# [게이트] 노션 integration 토큰. 비우면 노션 연동 전체 비활성(기존 web 회의/회의록엔 영향 없음).
# GitHub 쪽 secret 이름은 organization secret 과 겹쳐 CONVENE_NOTION_TOKEN 을 쓴다.
# 개발환경에서 연동을 테스트하려면 아래 주석을 풀고 값을 채운다.
# NOTION_TOKEN=
# 회의 자동 생성 폴링이 조회할 노션 이슈 DB ID들(콤마 구분). 팀/프로젝트 이슈 관리 DB가 여럿이라 복수.
# NOTION_DB_IDS=team-db-id,project-db-id
# 즉시 버튼(GET /notion/meetings) HMAC 서명 키. 비우면 즉시 경로 컨트롤러 미등록.
# NOTION_SIGNING_SECRET=
# 자동 폴링 주기(cron, 초 포함 6필드). 기본 30분마다. 즉시성은 버튼 경로가 담당. 예: 0 */5 * * * *
# NOTION_POLL_CRON='0 */30 * * * *'
# 노션 API 상세 옵션. 기본 버전 2025-09-03(멀티소스 DB/data_sources API) / base https://api.notion.com / 타임아웃 30000ms
# NOTION_VERSION=2025-09-03
# NOTION_BASE_URL=https://api.notion.com
# NOTION_TIMEOUT_MS=30000
